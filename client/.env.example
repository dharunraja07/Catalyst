# Base URL of your deployed backend API (Render, Railway, etc.)
# Leave unset to use the same-origin "/api" (only works if the API is deployed on the same domain, e.g. Vercel serverless functions)
VITE_API_URL=https://your-backend.onrender.com/api

# Jitsi Meet server domain used for video calls
VITE_JITSI_DOMAIN=meet.element.io

# Google OAuth Client ID (for Google sign-in)
VITE_GOOGLE_CLIENT_ID=
