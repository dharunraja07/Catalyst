NODE_ENV=development

# --- MongoDB: local for testing, Atlas for deployment ---
# This app connects to whatever MONGO_URI you provide — nothing else in the
# code needs to change between local testing and deployment, just this value.
#
# Option A — local MongoDB on your PC (fast, no internet needed once installed):
#   1. Install MongoDB Community Server / start it via Docker:
#      docker run -d -p 27017:27017 --name local-mongo mongo:7
#   2. MONGO_URI=mongodb://127.0.0.1:27017/ai-learning
#
# Option B — MongoDB Atlas (use this for Render/production, and optionally locally too):
#   Create a free cluster at https://www.mongodb.com/cloud/atlas, add a database
#   user + password, allow your IP (or 0.0.0.0/0 for quick testing), then copy
#   the connection string from "Connect > Drivers".
MONGO_URI=mongodb://127.0.0.1:27017/ai-learning

JWT_SECRET=change-this-to-a-long-random-secret
PORT=4000
GEMINI_API_KEY=your-gemini-api-key
CLIENT_URL=http://localhost:5173

# Optional escape hatch: only used if MONGO_URI above is left empty. Spins up
# a temporary in-memory MongoDB instance instead of Atlas, for a quick local
# trial run without any Atlas account. Leave this false/unset otherwise.
USE_MEMORY_MONGO=false

# --- Render deployment notes (safe to ignore locally) ---
# On Render, set these in the dashboard's Environment tab, not in a committed .env file:
#   NODE_ENV=production
#   MONGO_URI=<your MongoDB Atlas connection string>
#   JWT_SECRET=<a long random secret>
#   GEMINI_API_KEY=<your Gemini API key>
#   CLIENT_URL=https://your-vercel-app.vercel.app
# Render supplies PORT automatically - do not hardcode it in production.
# CLIENT_URL supports a comma-separated list, e.g.:
#   CLIENT_URL=https://your-vercel-app.vercel.app,http://localhost:5173
