# Server runtime
NODE_ENV=development
PORT=4000

# Database (MongoDB Atlas connection string)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/catalyst?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace_with_a_long_random_secret

# CORS - comma separated list of allowed frontend origins (your Vercel URL(s))
CLIENT_URL=https://your-app.vercel.app

# AI Provider Keys (at least one required)
GEMINI_API_KEY=
GROQ_API_KEY=
AI_PROVIDER_DEFAULT=gemini

# SMTP / Email (optional, needed for password reset emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=

# Study Groups
MAX_GROUP_MEMBERS=70
